APP_NAME="Customer Support Chatbot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatbot_db
DB_USERNAME=root
DB_PASSWORD=

# ─────────────────────────────────────────────────────
# GROQ API — Get your free key at https://console.groq.com
# Free tier: 14,400 requests/day
# ─────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─────────────────────────────────────────────────────
# CORS — Allow requests from your React dev server
# ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
